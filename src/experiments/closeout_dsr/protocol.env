# Frozen closeout protocol. Do not tune these values after seeing results.

PROFILE="habitat_test"
EXPECTED_HABITAT_REVISION="cdbb4880519505adf45fba0f0c0c3a3fd18a2a55"
TRAIN_SEEDS="100 200 300"
EVAL_SEED="2026"

TOTAL_STEPS="1000000"
NUM_ENVIRONMENTS="5"
NUM_CHECKPOINTS="10"
EVAL_EPISODES="100"
EVAL_NUM_ENVIRONMENTS="2"
EVAL_SPLIT="val"

DSR_ENV_TASK="DynamicSuccessRewardGymHabitatEnv"
DIAGNOSTIC_ENV_TASK="StopDiagnosticGymHabitatEnv"
DSR_FORMULA="success_reward * exp((success_distance - final_distance) / success_distance)"

HABITAT_ROOT="${HABITAT_ROOT:-$HOME/habitat-lab}"
PYTHON_BIN="${PYTHON_BIN:-python}"
EGL_VENDOR_JSON="${EGL_VENDOR_JSON:-/usr/share/glvnd/egl_vendor.d/10_nvidia.json}"
ALLOW_REVISION_MISMATCH="0"
PYTHONNOUSERSITE="1"
